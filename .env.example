# 複製這個檔案為 .env 並填入你的金鑰(本機測試用;正式排程請改設定 GitHub Actions Secrets)

## 機票監控系統

# https://serpapi.com/ 註冊後在 dashboard 取得
SERPAPI_API_KEY=

# LINE Developers Console -> Messaging API channel -> Channel access token
LINE_CHANNEL_ACCESS_TOKEN=

# 選填。若留空,會用 broadcast 推播給該官方帳號的所有好友;
# 若只想推給特定使用者,填入該使用者的 LINE userId。
LINE_USER_ID=

## IG 留言關鍵字自動回覆系統

# 伺服器埠號
PORT=3000

# 自訂的 Webhook 驗證字串，設定 Meta App Webhook 時要填一樣的值
VERIFY_TOKEN=your_custom_verify_token

# Instagram 專業帳號的使用者 ID（透過 /auth/callback 授權完成後會顯示）
IG_BUSINESS_ACCOUNT_ID=your_ig_business_account_id

# 透過 Instagram Business Login 授權後取得的長效 Access Token
IG_ACCESS_TOKEN=your_ig_access_token

# Instagram Graph API 版本
GRAPH_API_VERSION=v21.0

# Meta App 的 App ID（應用程式編號），OAuth 交換 token 時要用
IG_APP_ID=your_meta_app_id

# Meta App Secret，用來驗證 webhook 請求簽章，也用於 OAuth 交換 token
APP_SECRET=your_meta_app_secret

# Instagram Business Login 的回呼網址，要跟 App 後台設定的一致
IG_REDIRECT_URI=https://your-domain.example.com/auth/callback

# 同一位留言者在幾分鐘內只會被自動回覆一次，避免洗版
COOLDOWN_MINUTES=10
