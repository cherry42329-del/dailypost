# 複製這個檔案為 .env 並填入你的金鑰(本機測試用;正式排程請改設定 GitHub Actions Secrets)

## 機票監控系統

# https://serpapi.com/ 註冊後在 dashboard 取得
SERPAPI_API_KEY=

# LINE Developers Console -> Messaging API channel -> Channel access token
LINE_CHANNEL_ACCESS_TOKEN=

# 選填。若留空,會用 broadcast 推播給該官方帳號的所有好友;
# 若只想推給特定使用者,填入該使用者的 LINE userId。
LINE_USER_ID=

## IG 留言關鍵字自動回覆系統

# 伺服器埠號
PORT=3000

# 自訂的 Webhook 驗證字串，設定 Meta App Webhook 時要填一樣的值
VERIFY_TOKEN=your_custom_verify_token

# Instagram 專業帳號（Business/Creator）的 ID
IG_BUSINESS_ACCOUNT_ID=your_ig_business_account_id

# 綁定該 IG 帳號之 Facebook 粉絲專頁的 Page Access Token
PAGE_ACCESS_TOKEN=your_page_access_token

# Instagram Graph API 版本
GRAPH_API_VERSION=v21.0

# Meta App Secret（用來驗證 webhook 請求簽章，非必填但強烈建議設定）
APP_SECRET=your_meta_app_secret

# 同一位留言者在幾分鐘內只會被自動回覆一次，避免洗版
COOLDOWN_MINUTES=10
